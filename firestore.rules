rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null; }

    // 회차 설정: 누구나 읽기, 관리자만 쓰기
    match /settings/{doc} {
      allow read: if true;
      allow write: if admin();
    }

    // 응시자 원본(휴대폰번호 포함): 관리자만
    match /students/{examNo} {
      allow read, write: if admin();
    }

    // 조회용 사본: 키(이름+휴대폰 해시)를 아는 사람만 1건 읽기 가능, 목록 조회 불가
    match /lookup/{key} {
      allow get: if true;
      allow list: if admin();
      allow write: if admin();
    }

    // 출석: 관리자만
    match /attendance/{examNo} {
      allow read, write: if admin();
    }
  }
}
